APP_ENV=development
DATABASE_URL=sqlite:///./data/migrateflow.db
UPLOAD_ROOT=./uploads
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=10485760
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_PARALLEL_WORKERS=3
LLM_FAILOVER_PROVIDER=fallback
MODEL_MODE=ollama
MAPPING_FAST_PATH=true
MAX_SOURCE_ROWS=50000
MAX_SOURCE_COLUMNS=100
MOCK_TARGET_BASE_URL=
DEMO_FAILURES=false
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
AUTO_CREATE_SCHEMA=true
POSTGRES_USER=migrateflow
POSTGRES_PASSWORD=
POSTGRES_DB=migrateflow
